{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleanworld",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-10",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "cleanworld.live", "custom_domain": true },
    { "pattern": "www.cleanworld.live", "custom_domain": true }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clean-world",
      "database_id": "d204ff77-fc19-4fb8-afb6-50acd07a710e",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
