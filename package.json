{
  "name": "clean-world",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_SHOW_UNCONFIRMED=1 react-router dev",
    "dev:worker": "wrangler dev --port 8787 --var ADMIN_DEV_BYPASS:1",
    "build": "react-router build && node tools/postbuild.mjs",
    "preview": "VITE_TURNSTILE_SITE_KEY= npm run build && wrangler dev --port ${PORT:-8787} --inspector-port 0 --var ADMIN_DEV_BYPASS:1",
    "preview:draft": "VITE_TURNSTILE_SITE_KEY= VITE_SHOW_UNCONFIRMED=1 npm run build && wrangler dev --port ${PORT:-8787} --inspector-port 0 --var ADMIN_DEV_BYPASS:1",
    "typegen": "react-router typegen",
    "lint": "react-router typegen && tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply clean-world --local",
    "db:migrate:remote": "wrangler d1 migrations apply clean-world --remote",
    "deploy": "npm run build && node tools/postbuild.mjs --verify-production && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-router/node": "^7.18.5",
    "isbot": "^5.2.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
